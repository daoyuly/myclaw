{
  "name": "@myclaw/cli",
  "version": "0.1.0",
  "description": "MyClaw command line interface",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "bin": {
    "myclaw": "./dist/cli.mjs"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts src/cli.ts --format esm --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@myclaw/core": "workspace:*",
    "@myclaw/logger": "workspace:*",
    "@myclaw/storage": "workspace:*",
    "@myclaw/rule-engine": "workspace:*",
    "commander": "^12.0.0",
    "inquirer": "^9.2.0",
    "chalk": "^5.3.0"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.0",
    "@types/node": "^20.11.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  }
}
