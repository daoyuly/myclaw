{
  "name": "@myclaw/desktop",
  "version": "0.1.0",
  "description": "MyClaw Desktop Application",
  "main": "./out/main/index.js",
  "author": "MyClaw Team",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "electron-builder install-app-deps",
    "generate-icons": "node scripts/generate-icons.js && node scripts/generate-ico.js",
    "build:unpack": "pnpm build && electron-builder --dir",
    "build:win": "pnpm build && electron-builder --win",
    "build:mac": "pnpm build && electron-builder --mac",
    "build:linux": "pnpm build && electron-builder --linux",
    "build:all": "pnpm build && electron-builder --win --mac --linux"
  },
  "dependencies": {
    "@myclaw/env-manager": "workspace:*",
    "@myclaw/gateway": "workspace:*",
    "@myclaw/logger": "workspace:*",
    "@myclaw/storage": "workspace:*",
    "@tanstack/react-query": "^5.90.21",
    "clsx": "^2.1.1",
    "electron-updater": "^6.1.7",
    "express": "^4.18.2",
    "lucide-react": "^0.577.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.1",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "png-to-ico": "^3.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.34.5",
    "typescript": "^5.3.3",
    "vite": "^5.4.21",
    "vitest": "^3.0.0"
  }
}
